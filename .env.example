APP_NAME="Observador de Tendencias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=trend_observer
DB_USERNAME=trend_observer
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# CJ Dropshipping
CJ_API_EMAIL=
CJ_API_KEY=
# true recién después de probar CjOrderService con un pedido real de bajo valor
CJ_AUTO_SUBMIT_ORDERS=false

# Pesos del score combinado (deben sumar 1.0)
SCORING_TREND_WEIGHT=0.6
SCORING_SUPPLIER_WEIGHT=0.4

# Mercado Pago (checkout/pagos de la tienda)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Multiplicador sobre el costo del proveedor para fijar precio de venta
SHOP_MARKUP_MULTIPLIER=1.8
